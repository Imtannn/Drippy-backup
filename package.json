{
	"name": "meteor-lume-template",
	"license": "MIT",
	"// TODO: we want to use type:module, but Meteor code is still CommonJS. For now we set type:commonjs, then import our es modules from server/entry.js on the server": "",
	"type": "commonjs",
	"scripts": {
		"start": "npm run dev",
		"build": "npm run _link && tsc",
		"build:watch": "npm run _link && tsc --watch",
		"build:clean": "npm run clean && npm run build",
		"dev": "npm run build:clean && concurrently --kill-others --prefix-colors=auto --names=typescript,meteor 'tsc --watch' 'npm run _meteor'",
		"dev:mobile": "./start-mobile.sh",
		"_link": "symlink-dir imports public/imports",
		"_meteor": "meteor --exclude-archs web.browser.legacy --no-lint",
		"_meteor:mobile": "MOBILE_DDP_URL=http://192.168.80.141:3000 MOBILE_ROOT_URL=http://192.168.80.141:3000 meteor run --exclude-archs web.browser.legacy --no-lint --port 3000",
		"clean": "npm run _clean:unix || npm run --script-shell=pwsh _clean:windows",
		"_clean:unix": "rm -rf `find client -name '*.js*'` && rm -rf `find public -name '*.js*'` && rm -rf `find server -name '*.js*'` && rm -rf `find imports -name '*.js*'`",
		"_clean:windows": "Get-ChildItem -r -i client | Where{$_.Name -Match '*.\\.js*.'} | rm -r -fo && Get-ChildItem -r -i public | Where{$_.Name -Match '*.\\.js*.'} | rm -r -fo && Get-ChildItem -r -i server | Where{$_.Name -Match '*.\\.js*.'} | rm -r -fo",
		"publish": "...TODO...",
		"typecheck": "lume typecheck",
		"typecheck:watch": "lume typecheckWatch",
		"fetch-combined-assets": "chmod +x scripts/run-combined-assets.sh && ./scripts/run-combined-assets.sh"
	},
	"overrides": {
		"@lume/element": "$@lume/element"
	},
	"dependencies": {
		"@babel/runtime": "^7.15.4",
		"@lume/element": "^0.16.1",
		"@sendgrid/mail": "^8.1.5",
		"@tweenjs/tween.js": "^18.6.4",
		"@types/meteor": "^2.9.8",
		"@types/three": "^0.174.0",
		"aws-sdk": "^2.1692.0",
		"handlebars": "^4.7.8",
		"jquery": "^3.7.1",
		"lume": "^0.3.0-alpha.46",
		"meteor-node-stubs": "^1.0.0",
		"solid-js": "^1.9.0",
		"symlink-dir": "^6.0.5",
		"three": "^0.174.0",
		"typescript": "^5.0.0"
	},
	"devDependencies": {
		"@lume/cli": "^0.15.0",
		"concurrently": "^9.1.2",
		"prettier": "3.5.3",
		"sharp": "^0.34.4"
	},
	"meteor": {
		"mainModule": {
			"server": "server/entry.js"
		}
	}
}
