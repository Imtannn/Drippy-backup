<html>
	<head>
		<meta charset='utf-8' />
		<meta name='viewport' content='width=device-width, initial-scale=1.0' />
		<title>New Order Notification</title>
		<style>
			body {
				font-family: Arial, sans-serif;
				line-height: 1.6;
				color: #333;
				max-width: 600px;
				margin: 0 auto;
				padding: 20px;
			}
			.header {
				background: #e56be8;
				color: white;
				padding: 30px;
				text-align: center;
				border-radius: 8px 8px 0 0;
			}
			.content {
				background: #f9f9f9;
				padding: 30px;
				border-radius: 0 0 8px 8px;
			}
			.order-info {
				background: white;
				padding: 20px;
				border-radius: 8px;
				margin: 20px 0;
				border: 1px solid #ddd;
			}
			.item {
				display: flex;
				justify-content: space-between;
				padding: 10px 0;
				border-bottom: 1px solid #eee;
			}
			.total {
				font-weight: bold;
				font-size: 1.2em;
				border-top: 2px solid #e56be8;
				padding-top: 10px;
			}
			.footer {
				text-align: center;
				margin-top: 30px;
				font-size: 12px;
				color: #666;
			}
		</style>
	</head>
	<body>
		<div class='header'>
			<h1>📦 New {{#if isRetail}}Retail{{/if}}{{#if isWholesale}}Wholesale{{/if}} Order!</h1>
			<p>Order #{{orderId}}</p>
		</div>

		<div class='content'>
			<p>We have a {{#if isRetail}}retail{{/if}}{{#if isWholesale}}wholesale{{/if}} order from {{userEmail}}</p>

			<div class='order-info'>
				<h3>📦 Order Details</h3>
				<p><strong>Order Number:</strong> {{orderId}}</p>
				<p><strong>Order Date:</strong> {{orderDate}}</p>
				<p><strong>Customer:</strong> {{userName}} ({{userEmail}})</p>

				<h4>Items Ordered:</h4>
				{{#each items}}
					<div class='item'>
						<div>
							<strong>{{name}}</strong><br />
							<small>{{description}}</small><br />
							
							{{#if ../isWholesale}}
								{{#if sizes}}
									{{#each sizes}}
										<small style="margin-left: 16px;">Size {{size}}: {{quantity}} pcs @ ${{price}}</small><br />
									{{/each}}
									<small><strong>Total Qty: {{../quantity}}</strong></small>
								{{/if}}
							{{/if}}
							
							{{#if ../isRetail}}
								<small style="margin-left: 16px;">
									<strong>Size:</strong> {{selectedSize}} | 
									<strong>Qty:</strong> {{quantity}} pcs
								</small><br />
								{{#if customMeasurement}}
									<div style="margin-left: 16px; margin-top: 8px; padding: 6px; background: #fff3cd; border: 1px solid #ffeaa7; border-radius: 4px;">
										<small style="font-weight: bold; color: #856404;">⚠️ Custom Measurements Required:</small><br />
										<small style="color: #856404;">
											Bust: {{customMeasurement.bust}}cm | 
											Waist: {{customMeasurement.waist}}cm | 
											Hips: {{customMeasurement.hips}}cm<br />
											Shoulder: {{customMeasurement.shoulder}}cm | 
											Shoulder to Knee: {{customMeasurement.shoulderToKnee}}cm
										</small>
									</div>
								{{/if}}
							{{/if}}
						</div>
						<div>${{price}}</div>
					</div>
				{{/each}}

				<div class='item total'>
					<div>Total Amount:&nbsp;</div>
					<div>${{totalAmount}}</div>
				</div>
			</div>

			<div class='order-info'>
				<h3>🚚 Shipping Information</h3>
				<p>{{shippingAddress.name}}<br />
					{{shippingAddress.street}}<br />
					{{shippingAddress.city}},
					{{shippingAddress.state}}
					{{shippingAddress.zipCode}}<br />
					{{shippingAddress.country}}</p>
			</div>


			<p>Please process this order promptly.</p>
			<p>Admin Notification System</p>
		</div>

		<div class='footer'>
			<p>© {{currentYear}} Drippy. All rights reserved.</p>
			<p>Admin notification for {{userEmail}}</p>
		</div>
	</body>
</html>