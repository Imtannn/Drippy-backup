<html>
	<head>
		<meta charset='utf-8' />
		<meta name='viewport' content='width=device-width, initial-scale=1.0' />
		<title>New Order Notification</title>
		<style>
			body {
				font-family: Arial, sans-serif;
				line-height: 1.6;
				color: #333;
				max-width: 600px;
				margin: 0 auto;
				padding: 20px;
			}
			.header {
				background: #e56be8;
				color: white;
				padding: 30px;
				text-align: center;
				border-radius: 8px 8px 0 0;
			}
			.content {
				background: #f9f9f9;
				padding: 30px;
				border-radius: 0 0 8px 8px;
			}
			.order-info {
				background: white;
				padding: 20px;
				border-radius: 8px;
				margin: 20px 0;
				border: 1px solid #ddd;
			}
			.item {
				display: flex;
				justify-content: space-between;
				padding: 10px 0;
				border-bottom: 1px solid #eee;
			}
			.total {
				font-weight: bold;
				font-size: 1.2em;
				border-top: 2px solid #e56be8;
				padding-top: 10px;
			}
			.footer {
				text-align: center;
				margin-top: 30px;
				font-size: 12px;
				color: #666;
			}
		</style>
	</head>
	<body>
		<div class='header'>
			<h1>📦 New Order Received!</h1>
			<p>Order #{{orderId}}</p>
		</div>

		<div class='content'>
			<p>We have an order from {{userEmail}}</p>

			<div class='order-info'>
				<h3>📦 Order Details</h3>
				<p><strong>Order Number:</strong> {{orderId}}</p>
				<p><strong>Order Date:</strong> {{orderDate}}</p>
				<p><strong>Customer:</strong> {{userName}} ({{userEmail}})</p>

				<h4>Items Ordered:</h4>
				{{#each items}}
					<div class='item'>
						<div>
							<strong>{{name}}</strong><br />
							<small>{{description}}</small><br />
							<small>Qty: {{quantity}}</small>
						</div>
						<div>{{price}}</div>
					</div>
				{{/each}}

				<div class='item total'>
					<div>Total Amount</div>
					<div>${{totalAmount}}</div>
				</div>
			</div>

			<div class='order-info'>
				<h3>🚚 Shipping Information</h3>
				<p>{{shippingAddress.name}}<br />
					{{shippingAddress.street}}<br />
					{{shippingAddress.city}},
					{{shippingAddress.state}}
					{{shippingAddress.zipCode}}<br />
					{{shippingAddress.country}}</p>
			</div>

			{{#if isCustomSize}}
				<div class='order-info'>
					<h3>📏 Custom Measurements</h3>
					{{#if customMeasurement}}
						<table style='width: 100%; border-collapse: collapse; margin-top: 10px;'>
							<tr style='background-color: #f8f9fa;'>
								<th style='padding: 8px; text-align: left; border: 1px solid #ddd;'>Measurement</th>
								<th style='padding: 8px; text-align: right; border: 1px solid #ddd;'>Value (cm)</th>
							</tr>
							<tr>
								<td style='padding: 8px; border: 1px solid #ddd;'>Bust</td>
								<td style='padding: 8px; text-align: right; border: 1px solid #ddd;'>{{customMeasurement.bust}}</td>
							</tr>
							<tr style='background-color: #f8f9fa;'>
								<td style='padding: 8px; border: 1px solid #ddd;'>Waist</td>
								<td style='padding: 8px; text-align: right; border: 1px solid #ddd;'>{{customMeasurement.waist}}</td>
							</tr>
							<tr>
								<td style='padding: 8px; border: 1px solid #ddd;'>Hips</td>
								<td style='padding: 8px; text-align: right; border: 1px solid #ddd;'>{{customMeasurement.hips}}</td>
							</tr>
							<tr style='background-color: #f8f9fa;'>
								<td style='padding: 8px; border: 1px solid #ddd;'>Shoulder</td>
								<td style='padding: 8px; text-align: right; border: 1px solid #ddd;'>{{customMeasurement.shoulder}}</td>
							</tr>
							<tr>
								<td style='padding: 8px; border: 1px solid #ddd;'>Shoulder to Knee</td>
								<td
									style='padding: 8px; text-align: right; border: 1px solid #ddd;'
								>{{customMeasurement.shoulderToKnee}}</td>
							</tr>
						</table>
					{{else}}
						<p>Standard size selected: <strong>{{selectedSize}}</strong></p>
					{{/if}}
				</div>
			{{else}}
				<div class='order-info'>
					<h3>📏 Size Information</h3>
					<p>Standard size selected: <strong>{{selectedSize}}</strong></p>
				</div>
			{{/if}}

			<p>Please process this order promptly.</p>
			<p>Admin Notification System</p>
		</div>

		<div class='footer'>
			<p>© {{currentYear}} Drippy. All rights reserved.</p>
			<p>Admin notification for {{userEmail}}</p>
		</div>
	</body>
</html>