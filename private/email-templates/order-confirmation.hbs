<html>
	<head>
		<meta charset='utf-8' />
		<meta name='viewport' content='width=device-width, initial-scale=1.0' />
		<title>Order Confirmation</title>
		<style>
			body {
				font-family: Arial, sans-serif;
				line-height: 1.6;
				color: #333;
				max-width: 600px;
				margin: 0 auto;
				padding: 20px;
			}
			.header {
				background: #e56be8;
				color: white;
				padding: 30px;
				text-align: center;
				border-radius: 8px 8px 0 0;
			}
			.content {
				background: #f9f9f9;
				padding: 30px;
				border-radius: 0 0 8px 8px;
			}
			.order-info {
				background: white;
				padding: 20px;
				border-radius: 8px;
				margin: 20px 0;
				border: 1px solid #ddd;
			}
			.item {
				display: flex;
				justify-content: space-between;
				padding: 10px 0;
				border-bottom: 1px solid #eee;
			}
			.total {
				font-weight: bold;
				font-size: 1.2em;
				border-top: 2px solid #e56be8;
				padding-top: 10px;
			}
			.footer {
				text-align: center;
				margin-top: 30px;
				font-size: 12px;
				color: #666;
			}
		</style>
	</head>
	<body>
		<div class='header'>
			<h1'>✅ Order Confirmed!</h1>
			<p>Order #{{orderId}}</p>
		</div>

		<div class='content'>
			<p>Hi {{userName}},</p>

			<p>Thank you for your order! We've received your payment and are preparing your custom items.</p>

			<div class='order-info'>
				<h3>📦 Order Details</h3>
				<p><strong>Order Number:</strong> {{orderId}}</p>
				<p><strong>Order Date:</strong> {{orderDate}}</p>

				<h4>Items Ordered:</h4>
				{{#each items}}
					<div class='item'>
						<div>
							<strong>{{name}}</strong><br />
							<small>{{description}}</small><br />
							<small>Quantity: {{quantity}}</small>
						</div>
						<div style='text-align: right;'>
							<strong>${{price}}</strong>
						</div>
					</div>
				{{/each}}

				<div class='item total'>
					<div>Total Amount</div>
					<div>${{totalAmount}}</div>
				</div>
			</div>

			<div class='order-info'>
				<h3>🚚 Shipping Information</h3>
				<p>{{shippingAddress.name}}<br />
					{{shippingAddress.street}}<br />
					{{shippingAddress.city}},
					{{shippingAddress.state}}
					{{shippingAddress.zipCode}}<br />
					{{shippingAddress.country}}</p>
			</div>

			{{#if isCustomSize}}
				<div class='order-info'>
					<h3>📏 Custom Measurements</h3>
					{{#if customMeasurement}}
						<table style='width: 100%; border-collapse: collapse; margin-top: 10px;'>
							<tr style='background-color: #f8f9fa;'>
								<th style='padding: 8px; text-align: left; border: 1px solid #ddd;'>Measurement</th>
								<th style='padding: 8px; text-align: right; border: 1px solid #ddd;'>Value (cm)</th>
							</tr>
							{{#if customMeasurement.bust}}
								<tr>
									<td style='padding: 8px; border: 1px solid #ddd;'><strong>Bust</strong></td>
									<td style='padding: 8px; text-align: right; border: 1px solid #ddd;'>{{customMeasurement.bust}}</td>
								</tr>
							{{/if}}
							{{#if customMeasurement.waist}}
								<tr>
									<td style='padding: 8px; border: 1px solid #ddd;'><strong>Waist</strong></td>
									<td style='padding: 8px; text-align: right; border: 1px solid #ddd;'>{{customMeasurement.waist}}</td>
								</tr>
							{{/if}}
							{{#if customMeasurement.hips}}
								<tr>
									<td style='padding: 8px; border: 1px solid #ddd;'><strong>Hips</strong></td>
									<td style='padding: 8px; text-align: right; border: 1px solid #ddd;'>{{customMeasurement.hips}}</td>
								</tr>
							{{/if}}
							{{#if customMeasurement.shoulder}}
								<tr>
									<td style='padding: 8px; border: 1px solid #ddd;'><strong>Shoulder</strong></td>
									<td
										style='padding: 8px; text-align: right; border: 1px solid #ddd;'
									>{{customMeasurement.shoulder}}</td>
								</tr>
							{{/if}}
							{{#if customMeasurement.shoulderToKnee}}
								<tr>
									<td style='padding: 8px; border: 1px solid #ddd;'><strong>Shoulder to Knee</strong></td>
									<td
										style='padding: 8px; text-align: right; border: 1px solid #ddd;'
									>{{customMeasurement.shoulderToKnee}}</td>
								</tr>
							{{/if}}
						</table>
					{{else}}
						<p><em>Custom measurements will be provided separately.</em></p>
					{{/if}}
				</div>
			{{/if}}

			<p>Thank you for choosing Drippy!</p>
			<p>The Drippy Team</p>
		</div>

		<div class='footer'>
			<p>© {{currentYear}} Drippy. All rights reserved.</p>
			<p>Order confirmation for {{userEmail}}</p>
		</div>
	</body>
</html>