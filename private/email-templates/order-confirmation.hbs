<html>
	<head>
		<meta charset='utf-8' />
		<meta name='viewport' content='width=device-width, initial-scale=1.0' />
		<title>Order Confirmation</title>
		<style>
			body {
				font-family: Arial, sans-serif;
				line-height: 1.6;
				color: #333;
				max-width: 600px;
				margin: 0 auto;
				padding: 20px;
			}
			.header {
				background: #e56be8;
				color: white;
				padding: 30px;
				text-align: center;
				border-radius: 8px 8px 0 0;
			}
			.content {
				background: #f9f9f9;
				padding: 30px;
				border-radius: 0 0 8px 8px;
			}
			.order-info {
				background: white;
				padding: 20px;
				border-radius: 8px;
				margin: 20px 0;
				border: 1px solid #ddd;
			}
			.item {
				display: flex;
				justify-content: space-between;
				padding: 10px 0;
				border-bottom: 1px solid #eee;
			}
			.total {
				font-weight: bold;
				font-size: 1.2em;
				border-top: 2px solid #e56be8;
				padding-top: 10px;
			}
			.footer {
				text-align: center;
				margin-top: 30px;
				font-size: 12px;
				color: #666;
			}
		</style>
	</head>
	<body>
		<div class='header'>
			<h1'>✅ Order Confirmed!</h1>
			<p>Order #{{orderId}}</p>
		</div>

		<div class='content'>
			<p>Hi {{userName}},</p>

			<p>Thank you for your order!</p>
			<p>{{brandName}} will contact you soon for more details of your order.</p>

			<div class='order-info'>
				<h3>📦 Order Details</h3>
				<p><strong>Order Number:</strong> {{orderId}}</p>
				<p><strong>Order Date:</strong> {{orderDate}}</p>

				<h4>Items Ordered:</h4>
				{{#each items}}
					<div style='margin-left: 16px; margin-bottom: 20px; padding-bottom: 15px; border-bottom: 1px solid #eee;'>
						<div><strong>{{name}}</strong></div>
						<div style='margin-left: 16px; color: #666;'><small>{{description}}</small></div>
						
						{{#if sizes}}
							{{#each sizes}}
								<div style='margin-left: 16px; margin-top: 5px;'>
									<span>Size {{size}}: </span>
									<span>{{quantity}} pcs @ ${{price}} = ${{price}}</span>
								</div>
							{{/each}}
							<div style='margin-left: 16px; margin-top: 8px; font-weight: bold;'>
								Item Total: {{quantity}} pcs - ${{price}}
							</div>
						{{else}}
							<div style='margin-left: 16px; margin-top: 5px;'>
								<span>Size: <strong>{{selectedSize}}</strong></span>
								<span style='margin-left: 10px;'>Quantity: <strong>{{quantity}}</strong></span>
								<span style='margin-left: 10px;'>Price: <strong>${{price}}</strong></span>
							</div>
							{{#if customMeasurement}}
								<div style='margin-left: 16px; margin-top: 8px; padding: 8px; background: #f0f0f0; border-radius: 4px;'>
									<div style='font-weight: bold; color: #e56be8;'>Custom Measurements:</div>
									<div style='margin-top: 4px; font-size: 12px;'>
										Bust: {{customMeasurement.bust}}cm |
										Waist: {{customMeasurement.waist}}cm |
										Hips: {{customMeasurement.hips}}cm<br>
										Shoulder: {{customMeasurement.shoulder}}cm |
										Shoulder to Knee: {{customMeasurement.shoulderToKnee}}cm
									</div>
								</div>
							{{/if}}
						{{/if}}
					</div>
				{{/each}}

				<div class='item total'>
					<div>Total Amount:&nbsp;</div>
					<div>${{totalAmount}}</div>
				</div>
			</div>

			<div class='order-info'>
				<h3>🚚 Shipping Information</h3>
				<p>{{shippingAddress.name}}<br />
					{{shippingAddress.street}}<br />
					{{shippingAddress.city}},
					{{shippingAddress.state}}
					{{shippingAddress.zipCode}}<br />
					{{shippingAddress.country}}</p>
			</div>

			{{#if designUrl}}
			<div class='order-info'>
				<p><strong>Your design:</strong> <a href="{{designUrl}}">{{designUrl}}</a></p>
			</div>
			{{/if}}

			<p>Thank you for choosing Drippy!</p>
			<p>The Drippy Team</p>
		</div>

		<div class='footer'>
			<p>© {{currentYear}} Drippy. All rights reserved.</p>
			<p>Order confirmation for {{userEmail}}</p>
		</div>
	</body>
</html>